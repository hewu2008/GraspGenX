<?xml version="1.0" encoding="utf-8"?>
<!-- Right gripper extracted from ZR_H1PRO-1.2.00.H.V4.3_URDF_2025.12.02.urdf.
     Structure mirrors sharpa_wave/gripper.urdf: a `world` link mounts the
     gripper base (right_wrist_pitch_link) via a fixed world_joint, so the
     URDF can be attached to an arm flange later. -->
<robot
  name="zerith_right_gripper">
  <link
    name="world" />
  <joint
    name="world_joint"
    type="fixed">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="world" />
    <child
      link="right_wrist_pitch_link" />
    <axis
      xyz="0 0 0" />
  </joint>
  <link
    name="right_wrist_pitch_link">
    <inertial>
      <origin
        xyz="0.07825729 -0.00152809 0.00315775"
        rpy="0 0 0" />
      <mass
        value="0.5139" />
      <inertia
        ixx="0.0004612"
        ixy="-4.866e-05"
        ixz="-1.313e-05"
        iyy="0.00044669"
        iyz="-5.33e-06"
        izz="0.00060399" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/right_wrist_pitch_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.66667 0.69804 0.76863 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/right_wrist_pitch_link.STL" />
      </geometry>
    </collision>
  </link>
  <link
    name="right_jaw_left_finger_link">
    <inertial>
      <origin
        xyz="0.02884538 0.0506592 -0.00142357"
        rpy="0 0 0" />
      <mass
        value="0.057986" />
      <inertia
        ixx="1.518e-05"
        ixy="3.71e-06"
        ixz="1.13e-06"
        iyy="2.562e-05"
        iyz="-3.1e-07"
        izz="1.874e-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/right_jaw_left_finger_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.49804 0.49804 0.49804 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/right_jaw_left_finger_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="right_jaw_left_finger_joint"
    type="prismatic">
    <origin
      xyz="0.102 0 0"
      rpy="0 0 0" />
    <parent
      link="right_wrist_pitch_link" />
    <child
      link="right_jaw_left_finger_link" />
    <axis
      xyz="0 1 0" />
    <limit
      lower="-0.04"
      upper="0"
      effort="120"
      velocity="0.25" />
  </joint>
  <link
    name="right_jaw_right_finger_link">
    <inertial>
      <origin
        xyz="0.02884278 -0.05065791 -0.00142222"
        rpy="0 0 0" />
      <mass
        value="0.057987" />
      <inertia
        ixx="1.518e-05"
        ixy="-3.71e-06"
        ixz="1.14e-06"
        iyy="2.561e-05"
        iyz="3.1e-07"
        izz="1.872e-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/right_jaw_right_finger_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.49804 0.49804 0.49804 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/right_jaw_right_finger_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="right_jaw_right_finger_joint"
    type="prismatic">
    <origin
      xyz="0.102 0 0"
      rpy="0 0 0" />
    <parent
      link="right_wrist_pitch_link" />
    <child
      link="right_jaw_right_finger_link" />
    <axis
      xyz="0 -1 0" />
    <limit
      lower="-0.04"
      upper="0"
      effort="120"
      velocity="0.25" />
  </joint>
  <link
    name="right_jaw_camera_link">
    <inertial>
      <origin
        xyz="0.0 0.005 -0.01561719"
        rpy="0 0 0" />
      <mass
        value="0.05789" />
      <inertia
        ixx="1.081e-05"
        ixy="-0.0"
        ixz="-0.0"
        iyy="1.08e-05"
        iyz="-0.0"
        izz="1.658e-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/right_jaw_camera_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/right_jaw_camera_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="right_jaw_camera_joint"
    type="fixed">
    <origin
      xyz="0.11933 0.0090006 0.060373"
      rpy="-2.0071 0 -1.5708" />
    <parent
      link="right_wrist_pitch_link" />
    <child
      link="right_jaw_camera_link" />
    <axis
      xyz="0 0 0" />
  </joint>
  <link
    name="right_end_effector_link">
    <inertial>
      <origin
        xyz="-0.027172 -1.3538E-07 1.2941E-06"
        rpy="0 0 0" />
      <mass
        value="0.0066601" />
      <inertia
        ixx="1.2345E-05"
        ixy="5.8568E-11"
        ixz="2.3275E-11"
        iyy="6.5495E-08"
        iyz="-8.108E-15"
        izz="1.232E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/right_end_effector_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.68627 0.68627 0.68627 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/right_end_effector_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="right_end_effector_joint"
    type="fixed">
    <origin
      xyz="0.1435 0 0"
      rpy="0 0 0" />
    <parent
      link="right_wrist_pitch_link" />
    <child
      link="right_end_effector_link" />
    <axis
      xyz="0 0 0" />
  </joint>
  <!-- Default joint state: both fingers fully open (q=0). -->
  <joint_state
    name="right_jaw_left_finger_joint">
    <position
      value="0.0" />
    <velocity
      value="0.0" />
    <effort
      value="0.0" />
  </joint_state>
  <joint_state
    name="right_jaw_right_finger_joint">
    <position
      value="0.0" />
    <velocity
      value="0.0" />
    <effort
      value="0.0" />
  </joint_state>
</robot>
