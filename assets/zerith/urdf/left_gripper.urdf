<?xml version="1.0" encoding="utf-8"?>
<!-- Left gripper extracted from ZR_H1PRO-1.2.00.H.V4.3_URDF_2025.12.02.urdf.
     Structure mirrors sharpa_wave/gripper.urdf: a `world` link mounts the
     gripper base (left_wrist_pitch_link) via a fixed world_joint, so the
     URDF can be attached to an arm flange later. -->
<robot
  name="zerith_left_gripper">
  <link
    name="world" />
  <joint
    name="world_joint"
    type="fixed">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="world" />
    <child
      link="left_wrist_pitch_link" />
    <axis
      xyz="0 0 0" />
  </joint>
  <link
    name="left_wrist_pitch_link">
    <inertial>
      <origin
